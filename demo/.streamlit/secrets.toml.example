# Copy to .streamlit/secrets.toml for local runs. That file is gitignored and
# must stay that way — it holds a live credential.
#
# In production this file is NOT built into the image. The VPS keeps its own
# copy at ~/syndra-deploy/streamlit-secrets.toml (0600, owned by uid 1000) and
# infra/docker-compose.prod.yml bind-mounts it read-only at
# /app/.streamlit/secrets.toml. Rotating the key is therefore editing one line
# on the host plus `docker compose restart demo` — no rebuild, no push. Baking
# it into a layer instead would leave it extractable with `docker history`
# forever, even if a later layer deleted it.

# The public read-only key the demo uses by default, so a first-time visitor
# sees live data without being asked for a credential they do not have.
# Provision one with:
#   docker compose run --rm api python -m app.scripts.provision_client "demo_selfhosted"
#
# Use `run --rm`, not `exec`: exec runs inside the API container and shares its
# memory cgroup, competing with the workers for the same limit.
#
# The raw key is printed once at creation and never stored in plain text — only
# its SHA-256 hash reaches the database. If it is lost, issue a new one and
# deactivate the old row. Each deployment gets its own key so their rate-limit
# buckets stay separate and either can be revoked without affecting the other.
DEMO_API_KEY = "syndra_xxxxxxxxxxxxxxxxxxxxxxxx"

# Optional. Defaults to the production API when absent; override to point the
# demo at a local stack.
# API_BASE = "http://localhost:8000/api/v1"
