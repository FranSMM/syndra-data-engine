# Template for the repository-root .env file. Copy it and fill in real values:
#   cp .env.example .env
# Compose reads this file for every service; app/core/config.py also loads it
# directly when running scripts outside Docker.

# Database Configuration
POSTGRES_USER=syndra_user
POSTGRES_PASSWORD=your_secure_password_here
# Must match the Compose service name, not 'db' or 'localhost'. Alembic resolves
# this value as a DNS name from inside the container.
POSTGRES_SERVER=postgres
POSTGRES_PORT=5432
POSTGRES_DB=syndra_db

# Project Settings
PROJECT_NAME=Syndra Data Engine
# 'production' disables the Swagger UI at /docs and /redoc
ENVIRONMENT=development

# Namespaces the Compose project so container names stay predictable
COMPOSE_PROJECT_NAME=syndra-data-engine

# Prefect Configuration
PREFECT_API_URL=http://127.0.0.1:4200/api
PREFECT_SERVER_ANALYTICS_ENABLED=false
DO_NOT_TRACK=1
PREFECT_SERVER_EPHEMERAL_STARTUP_TIMEOUT_SECONDS=60
# Prefect keeps its own schema in the same Postgres instance
PREFECT_API_DATABASE_CONNECTION_URL=postgresql+asyncpg://syndra_user:your_secure_password_here@postgres:5432/prefect_db

# Qdrant Vector Store Configuration
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=financial_signals
# 384 corresponds to all-MiniLM-L6-v2, 768 for larger models
QDRANT_VECTOR_SIZE=384

# Redis (auth cache, response cache, rate limiting)
REDIS_URL=redis://redis:6379

# Deployment Configuration (consumed by deploy.sh)
VPS_USER=syndra
VPS_IP=your.vps.ip.here
DEPLOY_DIR=~/syndra-deploy

# Benchmarks (benchmarks/): use a trial key so it expires on its own
SYNDRA_BENCH_KEY=
# Optional label for the client machine in benchmark 05 results
# CLIENT_LABEL=laptop-wsl-home
