api.syndradata.com {
	# /metrics is for Prometheus over syndra_net only: it exposes routes,
	# latencies and corpus size, and Prometheus has no auth of its own.
	# handle blocks run in written order, so the 403 always precedes the proxy.
	@metrics path /metrics /metrics/*
	handle @metrics {
		respond 403
	}

	handle {
		reverse_proxy syndra_api:8000
	}
}

# Self-hosted Streamlit demo; reverse_proxy upgrades the WebSockets it relies on.
demo.syndradata.com {
	reverse_proxy syndra_demo:8501
}
